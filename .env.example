MPDM_EMAIL=prod@example.com
MPDM_PASSWORD=change-me
MPDM_URL=https://devicemanager.spectrio.com/mpdm/

MPDM_DEV_EMAIL=dev@example.com
MPDM_DEV_PASSWORD=change-me
MPDM_DEV_URL=https://mpdm-dev.inreality.com/mpdm/

INREALITY_EMAIL=platform@example.com
INREALITY_PASSWORD=change-me
INREALITY_URL=https://app.inreality.com/v3/
INREALITY_SUCCESS_URL=https://app.inreality.com/v3/auth0/

INREALITY_DEV_EMAIL=platform-dev@example.com
INREALITY_DEV_PASSWORD=change-me
INREALITY_DEV_URL=https://v3-dev.inreality.com/v3/
INREALITY_DEV_SUCCESS_URL=https://v3-dev.inreality.com/v3/auth0/

MONITOR_TOKEN=replace-with-a-long-random-value
PORT=8780
HOST=127.0.0.1
CHECK_INTERVAL_MINUTES=15
CHECK_ON_START=true
HEADLESS=true
FAILURE_NOTIFICATION_THRESHOLD=2
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me

# Each full cycle runs Direct plus every configured proxy against all four URLs.
# An alert is sent only when the number of failed networks is greater than this value.
# Single proxy (use this only when all credentials are shared).
# PROXY_URL=http://your-vps-proxy.example.com:8000
# PROXY_USERNAME=replace-with-proxy-username
# PROXY_PASSWORD=replace-with-proxy-password
# Multiple proxies with different credentials: URL-encode special characters in username/password.
PROXY_LIST=JP-Tokyo=http://tokyo-user:tokyo%40password@proxy1.example.com:8000;UK-London=http://london-user:london%23password@proxy2.example.com:8000;US-Seattle=http://seattle-user:seattle%40password@proxy3.example.com:8000
# Optional global fallback credentials for list entries without username:password@ in the URL.
# PROXY_USERNAME=replace-with-fallback-username
# PROXY_PASSWORD=replace-with-fallback-password
# Keep this false so proxy checks use the same page-loading behavior as direct checks.
PROXY_BLOCK_NONESSENTIAL=false
# Timeout for each proxy page/login wait. Direct checks keep their existing timeouts.
PROXY_TIMEOUT_MS=60000

# Public read-only dashboard.
# The monitor stays private on 127.0.0.1:8780; only the dashboard listens on the LAN/public interface.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8781
DASHBOARD_MONITOR_URL=http://127.0.0.1:8780
DASHBOARD_POLL_INTERVAL_SECONDS=30
DASHBOARD_HISTORY_LIMIT=500
DASHBOARD_HISTORY_PATH=data/dashboard-history.json
