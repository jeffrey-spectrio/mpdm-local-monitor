MPDM_EMAIL=prod@example.com
MPDM_PASSWORD=change-me
MPDM_URL=https://devicemanager.spectrio.com/mpdm/

MPDM_DEV_EMAIL=dev@example.com
MPDM_DEV_PASSWORD=change-me
MPDM_DEV_URL=https://mpdm-dev.inreality.com/mpdm/

INREALITY_EMAIL=platform@example.com
INREALITY_PASSWORD=change-me
INREALITY_URL=https://app.inreality.com/v3/
INREALITY_SUCCESS_URL=https://app.inreality.com/v3/auth0/

INREALITY_DEV_EMAIL=platform-dev@example.com
INREALITY_DEV_PASSWORD=change-me
INREALITY_DEV_URL=https://v3-dev.inreality.com/v3/
INREALITY_DEV_SUCCESS_URL=https://v3-dev.inreality.com/v3/auth0/

MONITOR_TOKEN=replace-with-a-long-random-value
PORT=8787
HOST=127.0.0.1
CHECK_INTERVAL_MINUTES=15
CHECK_ON_START=true
HEADLESS=true
FAILURE_NOTIFICATION_THRESHOLD=2
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me

# Optional round-robin proxy monitoring.
# Direct checks still run on CHECK_INTERVAL_MINUTES.
# Proxy checks use one proxy per cycle, default every 120 minutes, and rotate in order.
PROXY_CHECK_INTERVAL_MINUTES=120
PROXY_CHECK_ON_START=false
PROXY_TARGETS=prod,app
PROXY_USERNAME=replace-with-proxy-username
PROXY_PASSWORD=replace-with-proxy-password
PROXY_LIST=Tokyo=http://191.96.254.138:6185;Seattle=http://31.56.127.193:7684;London=http://45.38.107.97:6014
PROXY_IP_CHECK_URL=https://ipv4.webshare.io/
